ertiaJS, Vue, JavaScript, MySQL\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cdiv class=\\\"foot-links\\\"\\u003e \\n\\u003cp\\u003e\\u003ca href=\\\"https://github.com/kenkozma17/libot-patient-management\\\"\\u003eGithub\\u003c/a\\u003e\\u003c/p\\u003e\\n\\u003c/div\\u003e\\n\\u003ch3\\u003e05 Baller Directory\\u003c/h3\\u003e\\n\\u003cp\\u003eA directory to help coaches rate and reference football players in the Philippines.\\u003c/p\\u003e\\n\\u003cp\\u003eStack: Laravel, InertiaJS, Vue, SCSS, MySQL\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cdiv class=\\\"foot-links\\\"\\u003e \\n\\u003cp\\u003e\\u003ca href=\\\"https://github.com/kenkozma17/footballer-directory\\\"\\u003eGithub\\u003c/a\\u003e\\u003c/p\\u003e\\n\\u003c/div\\u003e\",\"meta\":{\"title\":\"Projects\",\"date\":\"Dec 28, 2025\",\"description\":\"A curated selection of web projects showcasing modern frontend development, performance-focused builds, animation-driven interfaces, and real-world client solutions.\"}},\"__N_SSG\":true},\"page\":\"/[slug]\",\"query\":{\"slug\":\"projects\"},\"buildId\":\"7H5uEZWCXuV17zlzY-Nu9\",\"isFallback\":false,\"gsp\":true,\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"contentHtml":"<h1>Notable Projects</h1>\n<h2>Commercial Projects</h2>\n<p>A selection of web projects led or collaboratively delivered while working with digital agencies.</p>\n<div class=\"unstyled-list\">\n<ul>\n<li>001 <a href=\"https://blakegriffin.com/\">Blake Griffin</a></li>\n<li>002 <a href=\"https://www.braums.com/\">Braum's</a></li>\n<li>003 <a href=\"https://www.thebankofbennington.com/\">Bank of Bennington</a></li>\n<li>004 <a href=\"https://globalrefuge.org\">Global Refuge</a></li>\n<li>005 <a href=\"https://fnb-usda-map.liquidfish.com/\">FNB Loan Eligibility Map</a></li>\n<li>006 <a href=\"https://sod-calculator.liquidfish.com/\">Maddison Square Turf Sod Calculator</a></li>\n<li>007 <a href=\"https://venturetrailers.com\">Venture Trailers</a></li>\n<li>008 <a href=\"https